# ============================================================
# Brixen CRM — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# ============================================================

# ── Server ─────────────────────────────────────────────────
HOST=0.0.0.0
PORT=5050

# ── Database ───────────────────────────────────────────────
# Inside Docker this is set automatically to /app/data/hypetex.db
# DATABASE_URL=/app/data/hypetex.db

# ── SMTP Email (optional) ─────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Cookie Security ───────────────────────────────────────
# ── Companies House software filing (optional) ─────────────
# Presenter ID / password for the XML Gateway. If these are empty,
# Accounts still builds the pack and issues a sandbox receipt; the
# director can upload the HTML file in WebFiling.
# CH_PRESENTER_ID=
# CH_PRESENTER_AUTH=
# CH_XML_GATEWAY_URL=https://xmlgw.companieshouse.gov.uk/v1-0/xmlgw/Gateway

