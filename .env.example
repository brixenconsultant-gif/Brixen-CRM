# ============================================================
# Brixen CRM — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# ============================================================

# ── Server ─────────────────────────────────────────────────
HOST=0.0.0.0
PORT=5050

# ── Database ───────────────────────────────────────────────
# Inside Docker this is set automatically to /app/data/hypetex.db
# DATABASE_URL=/app/data/hypetex.db

# ── SMTP Email (optional) ─────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Cookie Security ───────────────────────────────────────
# Set to "true" in production behind HTTPS
# COOKIE_SECURE=true
