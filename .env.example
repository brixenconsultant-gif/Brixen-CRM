# Environment Configuration Template for Brixen Consultants CRM
WORDPRESS_BASE_URL="https://brixenconsultants.com"
# Public portal URL. The Python process still binds 127.0.0.1:5050 behind it.
CRM_BASE_URL="https://portal.brixenconsultants.com"
# Staff CRM URL (internal). Customer-facing emails use CLIENT_PANEL_URL instead.
PORTAL_PAGE_URL="https://portal.brixenconsultants.com"
CLIENT_PANEL_URL="https://brixenconsultants.com/client-panel/customer-messages"
WORDPRESS_WEBHOOK_SECRET="CHANGE_ME_IN_LOCAL_ENV"
DATABASE_URL="hypetex.db"
STORAGE_PATH="storage"
PORT=5050
HOST="127.0.0.1"

# Leave unset in production (Secure cookies stay on). Set 0 only for local HTTP.
# COOKIE_SECURE=0

# Companies House REST API key (also saved in System Settings).
# Create one at https://developer.company-information.service.gov.uk/
COMPANIES_HOUSE_API_KEY=""

# SMTP Transactional Email Config
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT=587
SMTP_USER="notifications@brixenconsultants.com"
SMTP_PASS=""
